{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Breathe",
  "version": "1.0.0",
  "identifier": "com.breathe.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Breathe",
        "width": 960,
        "height": 630,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
