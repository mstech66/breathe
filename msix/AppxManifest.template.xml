<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store (MSIX) manifest for Breathe.
  build-msix.ps1 fills in the {{...}} values. The identity values must match
  Partner Center → your app → Product management → Product identity exactly.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>{{DISPLAY_NAME}}</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Windows 10 1809 or later. Breathe uses the WebView2 runtime that ships with Windows. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="Breathe.exe" EntryPoint="Windows.FullTrustApplication">
      <!-- Start menu, search and taskbar name. Can be shorter than the Store name above. -->
      <uap:VisualElements
        DisplayName="Breathe"
        Description="A calm work–rest rhythm with guided breathing breaks."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="Breathe" />
      </uap:VisualElements>

      <Extensions>
        <!-- Lets people switch "launch at login" on in Settings → Apps → Startup -->
        <desktop:Extension Category="windows.startupTask" Executable="Breathe.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="BreatheStartup" Enabled="false" DisplayName="Breathe" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
